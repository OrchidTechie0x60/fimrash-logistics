# Fimrash Logistics Services - Environment Configuration for Vercel
# Set this in your Vercel Project Settings > Environment Variables

# Point this to your Whogohost PHP Backend API endpoint
# Examples:
# VITE_API_BASE_URL=https://api.fimrash.com
# VITE_API_BASE_URL=https://fimrash.com/backend/public
# VITE_API_BASE_URL=https://orchidbyte-solutions.com.ng/fimrash-api/public
VITE_API_BASE_URL=https://api.fimrash.com
